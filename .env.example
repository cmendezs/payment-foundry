# Copy this file to .env and fill in your values.
# .env is gitignored, never commit real keys.
# See setup/environment-keys.md for where to find these.

# Stripe test mode keys (Dashboard > Developers > API keys, with "Test mode" on)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional: webhook signing secret for local testing (from `stripe listen`)
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: only needed if integrating Stripe Connect (Platform)
STRIPE_CONNECT_CLIENT_ID=ca_...
